{
  "name": "hide-and-troll",
  "version": "0.1.0",
  "description": "HIDE & TROLL - เกมซ่อนหาแปลงร่าง 3D ออนไลน์",
  "type": "module",
  "private": true,
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "test": "node --test tests/*.test.mjs",
    "dev": "node --watch server/server.js",
    "build": "node scripts/build-www.mjs",
    "build:www": "node scripts/build-www.mjs",
    "cap:sync": "npm run build:www && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "apk": "npm run cap:sync && cd android && gradlew.bat assembleRelease"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "socket.io": "^4.8.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
